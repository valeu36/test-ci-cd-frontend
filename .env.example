# Base URL of the API, without the version segment.
#
# It is baked in at BUILD time by Vite, so the bundle is environment-specific:
# build once per environment. On Railway set it as a service variable of the
# web service, e.g.
#   VITE_API_URL=https://${{api.RAILWAY_PUBLIC_DOMAIN}}/api
# and list the SPA's origin in the API's CORS_ORIGINS.
#
# Left relative here so `npm run dev` works with no setup: vite.config.ts
# proxies /api to API_PROXY_TARGET.
VITE_API_URL=/api

# Where the dev server proxies /api. Only used by `npm run dev`.
API_PROXY_TARGET=http://localhost:3000
